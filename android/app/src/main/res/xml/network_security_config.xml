<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP permitido: el monitor Streamlit en LAN no usa HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
